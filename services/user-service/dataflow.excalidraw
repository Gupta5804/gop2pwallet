    },
    {
      "id": "Q9rj7g2woZOukYj_Jy4OM",
      "type": "text",
      "x": 3380.930437231615,
      "y": -113.28537340621526,
      "width": 627,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
