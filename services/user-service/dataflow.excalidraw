    },
    {
      "id": "Fuuyxh4t3VqyX25alW0UI",
      "type": "text",
      "x": 3435.930437231615,
      "y": 31.714626593784743,
      "width": 517,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
