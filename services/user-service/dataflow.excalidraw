      "seed": 782730979,
      "version": 2,
      "versionNonce": 157265869,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1759255775410,
      "link": null,
      "locked": false,
      "text": "Routing: Your main.go file has already configured the Gin\nrouter, which catches the request and directs it to the\nuserHandler.RegisterUser method.",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Routing: Your main.go file has already configured the Gin router, which catches the request and directs it to the userHandler.RegisterUser method.",
